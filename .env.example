GROQ_API_KEY=replace_with_a_rotated_groq_key
# Chat model. llama-3.1-8b-instant is decommissioned; gpt-oss-120b is the current default.
# Check availability with: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss models reason before answering. "low" keeps replies fast and non-empty.
GROQ_REASONING_EFFORT=low
PORT=3001
